{
  "name": "@bim-studio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs && pnpm --filter @bim-studio/parametric-modeling-plugin build",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "build:scene-viewer": "node scripts/copy-wasm.mjs && tsc --noEmit && vite build",
    "build:engine-wasm": "node ../../scripts/build-wasm-bundle.mjs",
    "build:engine-wasm-bench": "node ../../scripts/build-wasm-bundle.mjs --features bench-viewer --out-dir public/dev/pkg",
    "bake:fixture": "node scripts/create-bake-validation-model.mjs",
    "smoke:parametric": "node scripts/smoke-parametric-browser.mjs",
    "gate:product-browser": "node scripts/gate-product-browser.mjs",
    "audit:viewer-performance": "node scripts/gate-viewer-performance-audit.mjs",
    "gate:webgpu": "node scripts/gate-product-browser.mjs --require-webgpu",
    "gate:viewer-soak": "node scripts/gate-viewer-soak.mjs",
    "benchmark:render-engines": "node scripts/gate-render-engine-comparison.mjs",
    "gate:online-flow": "node scripts/gate-online-flow.mjs",
    "gate:asset-material-flow": "node scripts/gate-asset-material-flow.mjs",
    "gate:data-center-flow": "node scripts/gate-data-center-flow.mjs",
    "gate:production-artifact": "node scripts/check-production-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify:model-diff-review": "node scripts/verify-model-diff-review.mjs",
    "gate:performance-evidence": "node scripts/gate-performance-evidence.mjs"
  },
  "dependencies": {
    "@bim-studio/contracts": "workspace:*",
    "@bim-studio/data-runtime": "workspace:*",
    "@bim-studio/deep-engine": "workspace:*",
    "@bim-studio/docs-runtime": "workspace:*",
    "@bim-studio/industrial-agent-orchestrator": "workspace:*",
    "@bim-studio/parametric-modeling-plugin": "workspace:*",
    "@bim-studio/plant-lite-simulation": "workspace:*",
    "@bim-studio/ppr-lite-engine": "workspace:*",
    "@bim-studio/scene-sdk": "workspace:*",
    "@bim-studio/server-sdk": "workspace:*",
    "@bim-studio/studio-core": "workspace:*",
    "@dimforge/rapier3d-compat": "0.19.3",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "2.11.1",
    "@thatopen/fragments": "3.4.5",
    "draco3dgltf": "1.5.7",
    "dxf-parser": "^1.1.2",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "es-module-lexer": "2.3.1",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "meshoptimizer": "1.0.1",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "replicad": "1.0.0",
    "replicad-opencascadejs": "1.0.0",
    "three": "0.185.1",
    "three-mesh-bvh": "^0.9.14",
    "urdf-loader": "0.13.1",
    "watlas": "1.0.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  }
}
