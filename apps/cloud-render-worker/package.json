{
  "name": "@bim-studio/cloud-render-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch src/index.ts",
    "build": "node ../../scripts/clean-dir.mjs dist && tsc -p tsconfig.json",
