{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-main",
  "description": "Minimum privileges for the bundled Deep Monkey Studio main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-get-server-profile",
    "allow-set-server-profile",
    "allow-clear-server-profile",
    "allow-get-auth-token",
    "allow-set-auth-token",
    "allow-clear-auth-token",
    "allow-start-local-api"
  ]
}
