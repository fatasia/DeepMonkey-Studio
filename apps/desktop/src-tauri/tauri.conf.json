{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepMonkey Studio",
  "version": "0.1.0",
  "identifier": "com.bimstudio.devstudio",
  "build": {
    "beforeDevCommand": "pnpm --filter @bim-studio/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/prepare-local-api-runtime.mjs && pnpm --filter @bim-studio/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data: blob:; media-src 'self' http: https: blob:; connect-src 'self' ipc: http: https: ws: wss:; worker-src 'self' blob:",
      "capabilities": ["desktop-main", "desktop-script-editor", "scene-viewer"]
    },
    "windows": [
      {
        "label": "main",
        "title": "DeepMonkey Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "create": false,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": [11, 17, 20, 255]
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "../local-api-bundle": "local-api"
    },
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "startMenuFolder": "DeepMonkey Studio",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
