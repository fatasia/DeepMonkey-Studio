    {
        "id": "example-td-request",
        "type": "function",
        "z": "example-td-tab",
        "name": "TDengine WebSocket + SQL",
        "func": "const tdengine = global.get('tdengine');\nconst database = env.get('TDENGINE_DATABASE') || 'test';\nconst user = env.get('TDENGINE_USER') || 'root';\nconst password = env.get('TDENGINE_PASSWORD') || 'taosdata';\nconst restBase = env.get('TDENGINE_REST_URL') || 'http://127.0.0.1:6041';\nconst wsUrl = env.get('TDENGINE_WS_URL') || restBase.replace(/^http/i, 'ws');\n// 改成你的超级表、表和字段。\nconst sql = 'SELECT * FROM perf_apps';\nlet connection = context.get('tdengineWsConnection');\nlet rows;\ntry {\n  if (!tdengine) throw new Error('未加载 @tdengine/websocket');\n  if (!connection) {\n    const config = new tdengine.WSConfig(wsUrl);\n    config.setUser(user);\n    config.setPwd(password);\n    config.setDb(database);\n    config.setTimeOut(10000);\n    connection = await tdengine.sqlConnect(config);\n    context.set('tdengineWsConnection', connection);\n  }\n  rows = await connection.query(sql);\n  const meta = rows.getMeta() || [];\n  const data = [];\n  while (await rows.next()) data.push(...(rows.getData() || []));\n  await rows.close();\n  msg.payload = { code: 0, column_meta: meta.map((column) => [column.name, column.type, column.length]), data };\n  node.status({ fill: 'green', shape: 'dot', text: 'WebSocket' });\n  return [msg, null];\n} catch (error) {\n  try { await rows?.close(); } catch {}\n  try { await connection?.close(); } catch {}\n  context.set('tdengineWsConnection', undefined);\n  node.status({ fill: 'yellow', shape: 'ring', text: 'REST fallback' });\n  node.warn(`TDengine WebSocket 查询失败，回退 REST：${error.message || error}`);\n  msg.method = 'POST';\n  msg.url = `${restBase.replace(/\\/$/, '')}/rest/sql/${encodeURIComponent(database)}`;\n  msg.headers = { 'content-type': 'text/plain; charset=utf-8', authorization: `Basic ${Buffer.from(`${user}:${password}`).toString('base64')}` };\n  msg.payload = sql;\n  return [null, msg];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "const connection = context.get('tdengineWsConnection');\nif (connection) await connection.close();\ncontext.set('tdengineWsConnection', undefined);",
        "libs": [],
        "x": 700,
        "y": 620,
        "wires": [
            [
                "example-td-normalize",
                "340ebd619fa66cb8"
            ],
            [
                "example-td-http"
            ]
        ]
    },
