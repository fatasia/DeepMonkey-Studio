[
  {
    "id": "bim-studio-flow",
    "type": "tab",
    "label": "BIM Studio 场景数据桥",
    "disabled": false,
    "info": "HTTP /iot/scene 接收统一场景消息，并广播到 WebSocket /iot/ws/scene。"
  },
  {
    "id": "scene-http-in",
    "type": "http in",
    "z": "bim-studio-flow",
    "name": "场景消息 HTTP",
    "url": "/scene",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 150,
    "y": 120,
    "wires": [["normalize-scene-message"]]
  },
  {
    "id": "normalize-scene-message",
    "type": "function",
    "z": "bim-studio-flow",
    "name": "规范化消息",
    "func": "const body = msg.payload || {};\nmsg.payload = {\n  source: String(body.source || 'http'),\n  key: String(body.key || ''),\n  value: body.value,\n  timestamp: body.timestamp || new Date().toISOString(),\n  ...(body.target ? { target: body.target } : {}),\n  ...(body.action ? { action: body.action } : {})\n};\nmsg.statusCode = 202;\nmsg._response = { payload: { accepted: true, timestamp: msg.payload.timestamp }, req: msg.req, res: msg.res };\nreturn [msg, msg._response];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 120,
    "wires": [["scene-ws-out", "scene-debug", "scene-dashboard-value"], ["scene-http-response"]]
  },
  {
    "id": "scene-ws-listener",
    "type": "websocket-listener",
    "path": "/ws/scene",
    "wholemsg": "false"
  },
  {
    "id": "scene-ws-out",
    "type": "websocket out",
    "z": "bim-studio-flow",
    "name": "广播到三维场景",
    "server": "scene-ws-listener",
    "client": "",
    "x": 650,
    "y": 90,
    "wires": []
  },
  {
    "id": "scene-http-response",
    "type": "http response",
    "z": "bim-studio-flow",
    "name": "202 Accepted",
    "statusCode": "",
    "headers": {},
    "x": 650,
    "y": 150,
    "wires": []
  },
  {
    "id": "scene-debug",
    "type": "debug",
    "z": "bim-studio-flow",
    "name": "场景消息",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 640,
    "y": 210,
    "wires": []
  },
  {
    "id": "bim-dashboard-base",
    "type": "ui-base",
    "name": "BIM Studio 看板",
    "path": "/dashboard",
    "appIcon": "",
    "includeClientData": true,
    "acceptsClientConfig": ["ui-notification", "ui-control"],
    "showPathInSidebar": false,
    "headerContent": "page",
    "navigationStyle": "default",
    "titleBarStyle": "default",
    "showReconnectNotification": true,
    "notificationDisplayTime": 1,
    "showDisconnectNotification": true,
    "allowInstall": false
  },
  {
    "id": "bim-dashboard-theme",
    "type": "ui-theme",
    "name": "BIM Studio Dark",
    "colors": {
      "surface": "#182126",
      "primary": "#d4a84f",
      "bgPage": "#11171b",
      "groupBg": "#182126",
      "groupOutline": "#2b3940"
    },
    "sizes": {
      "density": "default",
      "pagePadding": "12px",
      "groupGap": "12px",
      "groupBorderRadius": "8px",
      "widgetGap": "12px"
    }
  },
  {
    "id": "bim-dashboard-page",
    "type": "ui-page",
    "name": "设备总览",
    "ui": "bim-dashboard-base",
    "path": "/overview",
    "icon": "home",
    "layout": "grid",
    "theme": "bim-dashboard-theme",
    "breakpoints": [
      { "name": "Default", "px": 0, "cols": 3 },
      { "name": "Tablet", "px": 576, "cols": 6 },
      { "name": "Small Desktop", "px": 768, "cols": 9 },
      { "name": "Desktop", "px": 1024, "cols": 12 }
    ],
    "order": 1,
    "className": "",
    "visible": "true",
    "disabled": "false"
  },
  {
    "id": "bim-dashboard-group",
    "type": "ui-group",
    "name": "场景数据",
    "page": "bim-dashboard-page",
    "width": 6,
    "height": 1,
    "order": 1,
    "showTitle": true,
    "className": "",
    "visible": true,
    "disabled": false,
    "groupType": "default"
  },
  {
    "id": "scene-dashboard-intro",
    "type": "ui-markdown",
    "z": "bim-studio-flow",
    "group": "bim-dashboard-group",
    "name": "使用说明",
    "order": 1,
    "width": 6,
    "height": 0,
    "content": "## BIM Studio 数字孪生\n通过 HTTP、WebSocket、数据库或 IoT 节点接入实时数据，再映射到场景对象的颜色、显隐、位置与标签。",
    "className": ""
  },
  {
    "id": "scene-dashboard-value",
    "type": "ui-text",
    "z": "bim-studio-flow",
    "group": "bim-dashboard-group",
    "order": 2,
    "width": 6,
    "height": 1,
    "name": "最新场景消息",
    "label": "最新数据",
    "format": "{{msg.payload.key}} = {{msg.payload.value}}",
    "layout": "row-spread",
    "style": false,
    "font": "Helvetica",
    "fontSize": 16,
    "color": "#d9e2e7",
    "wrapText": true,
    "className": "",
    "value": "payload",
    "valueType": "msg",
    "wires": []
  }
]
