    {
        "id": "example-td-scene",
        "type": "function",
        "z": "example-td-tab",
        "name": "同步到场景与二维看板",
        "func": "const value = Number(msg.payload ?? 0);\nconst modelId = env.get('BIM_MODEL_ID') || '';\nconst base = { source: 'tdengine', key: 'value', value, timestamp: new Date().toISOString() };\nconst data = { ...msg, payload: base };\nconst scene = modelId ? { ...msg, payload: { ...base, key: 'alarmColor', value: value >= 80 ? '#ff4057' : value >= 60 ? '#d4a84f' : '#48b8ff', target: { modelId }, action: 'color' } } : null;\nreturn [data, scene];",
