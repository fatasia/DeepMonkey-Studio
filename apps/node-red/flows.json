    {
        "id": "normalize-scene-message",
        "type": "function",
        "z": "bim-studio-flow",
        "name": "规范化消息",
        "func": "const body = msg.payload || {};\nmsg.payload = {\n  source: String(body.source || 'http'),\n  key: String(body.key || ''),\n  value: body.value,\n  timestamp: body.timestamp || new Date().toISOString(),\n  ...(body.target ? { target: body.target } : {}),\n  ...(body.action ? { action: body.action } : {})\n};\nmsg.statusCode = 202;\nmsg._response = { payload: { accepted: true, timestamp: msg.payload.timestamp }, req: msg.req, res: msg.res };\nreturn [msg, msg._response];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 770,
        "y": 520,
        "wires": [
