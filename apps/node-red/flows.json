    {
        "id": "example-td-normalize",
        "type": "function",
        "z": "example-td-tab",
        "name": "取最新数值",
        "func": "const body = msg.payload || {};\nif (body.status && body.status !== 'succ') { throw new Error(body.desc || 'TDengine 2.x 查询失败'); }\nif (typeof body.code === 'number' && body.code !== 0) { throw new Error(body.desc || body.message || `TDengine 3.x 查询失败 (${body.code})`); }\nconst row = Array.isArray(body.data) ? body.data[0] : undefined;\nconst value = Array.isArray(row) ? row[row.length - 1] : row?.value;\nmsg.payload = Number(value ?? 0);\nmsg.topic = 'TDengine';\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1170,
        "y": 540,
        "wires": [
