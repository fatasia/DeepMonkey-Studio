      ]
    ]
  },
  {
    "id": "example-td-request",
    "type": "function",
    "z": "example-td-tab",
    "name": "TDengine REST + SQL",
    "func": "const base = env.get('TDENGINE_REST_URL') || 'http://127.0.0.1:6041';\nconst database = env.get('TDENGINE_DATABASE') || 'test';\nconst user = env.get('TDENGINE_USER') || 'root';\nconst password = env.get('TDENGINE_PASSWORD') || 'taosdata';\nmsg.method = 'POST';\nmsg.url = `${base.replace(/\\/$/, '')}/rest/sql/${encodeURIComponent(database)}`;\nmsg.headers = {\n  'content-type': 'text/plain; charset=utf-8',\n  authorization: `Basic ${Buffer.from(`${user}:${password}`).toString('base64')}`\n};\n// 改成你的超级表、表和字段。\nmsg.payload = 'SELECT LAST(ts) AS ts, LAST(current) AS value FROM meters';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 140,
    "wires": [
      [
        "example-td-http"
      ]
    ]
  },
  {
    "id": "example-td-http",
    "type": "http request",
    "z": "example-td-tab",
    "name": "执行 TDengine 查询",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "persist": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 560,
    "y": 140,
    "wires": [
