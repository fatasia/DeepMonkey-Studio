        "example-td-normalize"
      ]
    ]
  },
  {
    "id": "example-td-normalize",
    "type": "function",
    "z": "example-td-tab",
    "name": "取最新数值",
    "func": "const body = msg.payload || {};\nif (body.status && body.status !== 'succ') { throw new Error(body.desc || 'TDengine 查询失败'); }\nconst row = Array.isArray(body.data) ? body.data[0] : undefined;\nconst value = Array.isArray(row) ? row[row.length - 1] : row?.value;\nmsg.payload = Number(value ?? 0);\nmsg.topic = 'TDengine';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 770,
    "y": 140,
    "wires": [
      [
        "example-td-gauge",
        "example-td-debug",
        "example-td-scene"
      ]
    ]
  },
