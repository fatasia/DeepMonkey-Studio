+use cad_ir::math::Vec3;
+
+/// Squared point/triangle distance. Degenerate triangles retain their edges;
+/// non-finite inputs cannot certify that a boundary lies on a surface.
+pub(crate) fn distance_to_triangle(p: Vec3, t: [Vec3; 3]) -> f64 {
+    if !p.is_finite() || t.iter().any(|v| !v.is_finite()) {
+        return f64::INFINITY;
+    }
+    let (e0, e1, q) = (t[1] - t[0], t[2] - t[0], p - t[0]);
+    let scale = e0
+        .to_array()
+        .into_iter()
+        .chain(e1.to_array())
+        .map(f64::abs)
+        .fold(0.0, f64::max);
+    if !scale.is_finite() || !q.is_finite() {
+        return f64::INFINITY;
+    }
+    if scale == 0.0 {
+        return q.length_squared();
+    }
+    let divide = |v: Vec3, by: f64| Vec3::new(v.x / by, v.y / by, v.z / by);
+    let (a, b, q) = (divide(e0, scale), divide(e1, scale), divide(q, scale));
+    if !q.is_finite() {
+        return f64::INFINITY;
+    }
+    // Cross products preserve a skinny triangle's normal where the Gram
+    // determinant a*c-b*b cancels to zero. Never replace it with an epsilon.
+    let cross = a.cross(b);
+    let normal_scale = cross
+        .to_array()
+        .into_iter()
+        .map(f64::abs)
+        .fold(0.0, f64::max);
+    if normal_scale > 0.0 {
+        let normal = divide(cross, normal_scale);
+        let denominator = cross.dot(normal);
+        let u = q.cross(b).dot(normal) / denominator;
+        let v = a.cross(q).dot(normal) / denominator;
+        if u >= 0.0 && v >= 0.0 && u + v <= 1.0 {
+            let distance = q.dot(normal).abs() / normal.length() * scale;
+            return distance * distance;
+        }
+    }
+    // Outside the triangle (or collinear): the closest point is on an edge.
+    let edge_distance = |start: Vec3, end: Vec3| {
+        let edge = end - start;
+        let len2 = edge.length_squared();
+        let parameter = if len2 == 0.0 {
+            0.0
+        } else {
+            ((q - start).dot(edge) / len2).clamp(0.0, 1.0)
+        };
+        (q - (start + edge * parameter)).length_squared()
+    };
+    let squared = edge_distance(Vec3::ZERO, a)
+        .min(edge_distance(Vec3::ZERO, b))
+        .min(edge_distance(a, b));
+    let distance = squared.sqrt() * scale;
+    distance * distance
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn triangle_projection_and_all_boundary_regions() {
+        let tri = [Vec3::ZERO, Vec3::new(2.0, 0.0, 0.0), Vec3::Y];
+        for (p, expected) in [
+            (Vec3::new(0.5, 0.25, 2.0), 4.0),
+            (Vec3::new(1.0, -1.0, 0.0), 1.0),
+            (Vec3::new(-1.0, 0.5, 0.0), 1.0),
+            (Vec3::new(1.0, 1.0, 0.0), 0.2),
+            (Vec3::new(-1.0, -1.0, 0.0), 2.0),
+            (Vec3::new(3.0, 0.0, 0.0), 1.0),
+            (Vec3::new(0.0, 2.0, 0.0), 1.0),
+        ] {
+            assert!((distance_to_triangle(p, tri) - expected).abs() < 1e-12);
+            assert!((distance_to_triangle(p, [tri[2], tri[1], tri[0]]) - expected).abs() < 1e-12);
+        }
+    }
+
+    #[test]
+    fn degenerate_and_invalid_triangles() {
+        assert_eq!(distance_to_triangle(Vec3::Y, [Vec3::ZERO; 3]), 1.0);
+        assert_eq!(
+            distance_to_triangle(Vec3::Y, [Vec3::ZERO, Vec3::X, Vec3::X * 2.0]),
+            1.0
+        );
+        for value in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+            let invalid = Vec3::new(value, 0.0, 0.0);
+            assert_eq!(
+                distance_to_triangle(invalid, [Vec3::ZERO; 3]),
+                f64::INFINITY
+            );
+            assert_eq!(
+                distance_to_triangle(Vec3::ZERO, [invalid, Vec3::X, Vec3::Y]),
+                f64::INFINITY
+            );
+        }
+    }
+
+    #[test]
+    fn skinny_triangle_does_not_cancel_its_normal() {
+        // Finite synthetic geometry reproduces the AS-2940 determinant failure.
+        let tri = [
+            Vec3::ZERO,
+            Vec3::new(1e-3, 0.0, 1e10),
+            Vec3::new(0.0, 1e-3, 2e10),
+        ];
+        let p = tri[1] * 0.25 + tri[2] * 0.25;
+        let result = distance_to_triangle(p, tri);
+        assert!(result.is_finite() && result < 1e-20, "{result}");
+        for scale in [1e-100, 1.0, 1e100] {
+            let d = distance_to_triangle(
+                Vec3::Z * scale,
+                [Vec3::ZERO, Vec3::X * scale, Vec3::Y * scale],
+            );
+            assert!((d / (scale * scale) - 1.0).abs() < 1e-12);
+        }
+    }
+}
