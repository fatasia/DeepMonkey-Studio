+use cad_ir::{brep::Surface, math::Vec3};
+
+/// Chord sag permits a mesh edge to leave a curved surface, not a point from
+/// another face to become part of that surface. Never move the candidate.
+pub(crate) fn accepts(surface: &Surface, tolerance: f64, point: [f64; 3]) -> bool {
+    let p = Vec3::new(point[0], point[1], point[2]);
+    if !p.is_finite() || !tolerance.is_finite() || tolerance < 0.0 {
+        return false;
+    }
+    let Some(uv) = surface.invert(p, None) else {
+        return false;
+    };
+    let projected = surface.point_at(uv);
+    let scale = point.iter().fold(0.0_f64, |m, x| m.max(x.abs()));
+    let budget = tolerance.max(scale * f32::EPSILON as f64 * 2.0);
+    projected.is_finite() && (projected - p).length() <= budget
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cad_ir::math::Frame;
+
+    #[test]
+    fn chord_sag_does_not_authorize_a_point_off_the_cylinder() {
+        let surface = Surface::Cylinder {
+            frame: Frame::new(Vec3::ZERO, Vec3::Z, Vec3::X),
+            radius: 5.0,
+        };
+        assert!(accepts(&surface, 1e-5, [5.0, 0.0, 2.0]));
+        assert!(!accepts(&surface, 1e-5, [4.98, 0.0, 2.0]));
+        assert!(!accepts(&surface, 1e-5, [5.02, 0.0, 2.0]));
+        assert!(accepts(&surface, 1e-5, [5.0 + 1e-7, 0.0, 2.0]));
+    }
+
+    #[test]
+    fn model_tolerance_and_invalid_candidates_are_explicit() {
+        let surface = Surface::Plane {
+            frame: Frame::new(Vec3::ZERO, Vec3::Z, Vec3::X),
+        };
+        assert!(accepts(&surface, 1e-4, [1.0, 2.0, 5e-5]));
+        assert!(!accepts(&surface, 1e-4, [1.0, 2.0, 2e-4]));
+        assert!(!accepts(&surface, f64::NAN, [0.0; 3]));
+        assert!(!accepts(&surface, 1e-4, [f64::NAN, 0.0, 0.0]));
+    }
+}
