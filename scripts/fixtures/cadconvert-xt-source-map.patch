--- /dev/null
+++ b/native/crates/cad-ir/src/source_map.rs
@@ -0,0 +1,147 @@
+//! Source-file-local face identity, retained without splitting material draws.
+use crate::mesh::Mesh;
+
+#[derive(Debug, Clone)]
+pub struct FaceRange {
+    pub face: usize,
+    pub start: usize,
+    pub end: usize,
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct GeometrySourceMap {
+    pub format: String,
+    pub body: usize,
+    pub faces: Vec<usize>,
+    pub ranges: Vec<FaceRange>,
+    pub index_hash: u64,
+}
+
+pub fn index_hash(indices: &[u32]) -> u64 {
+    indices
+        .iter()
+        .flat_map(|value| value.to_le_bytes())
+        .fold(0xcbf29ce484222325, |hash, byte| {
+            (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3)
+        })
+}
+
+impl GeometrySourceMap {
+    pub fn bind(&mut self, mut ranges: Vec<FaceRange>, mesh: &Mesh) {
+        ranges.sort_by_key(|range| range.start);
+        self.ranges = ranges;
+        self.index_hash = index_hash(&mesh.indices);
+    }
+
+    pub fn validate(&self, mesh: &Mesh) -> Result<(), String> {
+        let mut next = 0;
+        if self.body == 0
+            || self.format.is_empty()
+            || self.faces.iter().any(|face| *face == 0)
+            || self
+                .faces
+                .iter()
+                .collect::<std::collections::BTreeSet<_>>()
+                .len()
+                != self.faces.len()
+            || self.index_hash != index_hash(&mesh.indices)
+        {
+            return Err("source face identity or mesh index fingerprint is invalid".into());
+        }
+        for range in &self.ranges {
+            if range.start != next
+                || range.end <= range.start
+                || range.end > mesh.indices.len()
+                || range.start % 3 != 0
+                || range.end % 3 != 0
+                || range.face >= self.faces.len()
+            {
+                return Err("source face ranges do not partition the triangle buffer".into());
+            }
+            next = range.end;
+        }
+        if next != mesh.indices.len() || next == 0 {
+            return Err("source face map has unmapped triangles".into());
+        }
+        if !mesh.parts.is_empty() {
+            let mut covered = 0usize;
+            for part in &mesh.parts {
+                if part.start as usize != covered || part.count % 3 != 0 {
+                    return Err("material parts do not partition source triangles".into());
+                }
+                covered += part.count as usize;
+            }
+            if covered != next {
+                return Err("material parts omit source triangles".into());
+            }
+        }
+        Ok(())
+    }
+
+    /// (primitive-local triangle start, triangle count, source FACE handle).
+    pub fn clip(&self, start: usize, count: usize) -> Vec<(usize, usize, usize)> {
+        let end = start + count;
+        let first = self.ranges.partition_point(|range| range.end <= start);
+        self.ranges[first..]
+            .iter()
+            .take_while(|range| range.start < end)
+            .map(|range| {
+                let lo = start.max(range.start);
+                let hi = end.min(range.end);
+                ((lo - start) / 3, (hi - lo) / 3, self.faces[range.face])
+            })
+            .collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture() -> (GeometrySourceMap, Mesh) {
+        let mesh = Mesh {
+            indices: vec![0, 1, 2, 0, 2, 3, 0, 3, 4],
+            ..Default::default()
+        };
+        let mut map = GeometrySourceMap {
+            format: "X_T".into(),
+            body: 7,
+            faces: vec![42, 99],
+            ..Default::default()
+        };
+        map.bind(
+            vec![
+                FaceRange {
+                    face: 1,
+                    start: 6,
+                    end: 9,
+                },
+                FaceRange {
+                    face: 0,
+                    start: 0,
+                    end: 6,
+                },
+            ],
+            &mesh,
+        );
+        (map, mesh)
+    }
+    #[test]
+    fn material_order_and_chunk_boundary_keep_source_identity() {
+        let (map, mesh) = fixture();
+        map.validate(&mesh).unwrap();
+        assert_eq!(map.clip(0, 3), vec![(0, 1, 42)]);
+        assert_eq!(map.clip(3, 6), vec![(0, 1, 42), (1, 1, 99)]);
+    }
+    #[test]
+    fn stale_reordering_and_invalid_coverage_are_rejected() {
+        let (map, mut mesh) = fixture();
+        mesh.indices.swap(0, 1);
+        assert!(map.validate(&mesh).is_err());
+        let (mut map, mesh) = fixture();
+        map.ranges[1].start = 3;
+        assert!(map.validate(&mesh).is_err());
+        map.ranges[1].start = 6;
+        map.ranges[1].face = 2;
+        assert!(map.validate(&mesh).is_err());
+    }
+}
diff --git a/native/crates/cad-export/src/glb_source_map_tests.rs b/native/crates/cad-export/src/glb_source_map_tests.rs
new file mode 100644
--- /dev/null
+++ b/native/crates/cad-export/src/glb_source_map_tests.rs
@@ -0,0 +1,106 @@
+use super::*;
+use cad_ir::scene::{Geometry, GeometryId, Node};
+use cad_ir::source_map::{FaceRange, GeometrySourceMap};
+
+fn fixture() -> Scene {
+    let mut scene = Scene::default();
+    // Enough unique vertices to force a 16-bit index split inside source face 42.
+    let mesh = Mesh {
+        positions: (0..65_541)
+            .map(|i| [i as f32, (i % 3) as f32, 0.0])
+            .collect(),
+        indices: (0..65_541).collect(),
+        ..Default::default()
+    };
+    let mut source = GeometrySourceMap {
+        format: "X_T".into(),
+        body: 7,
+        faces: vec![42, 99],
+        ..Default::default()
+    };
+    source.bind(
+        vec![
+            FaceRange {
+                face: 0,
+                start: 0,
+                end: 65_538,
+            },
+            FaceRange {
+                face: 1,
+                start: 65_538,
+                end: 65_541,
+            },
+        ],
+        &mesh,
+    );
+    let geometry = scene.add_geometry(Geometry {
+        name: "mapped".into(),
+        mesh: Some(mesh),
+        brep: None,
+        material: None,
+        face_materials: vec![],
+    });
+    scene.source_faces.insert(geometry, source);
+    let node = scene.add_node(Node {
+        geometry: Some(geometry),
+        ..Default::default()
+    });
+    scene.roots.push(node);
+    scene
+}
+
+fn json_of(bytes: &[u8]) -> Value {
+    let length = u32::from_le_bytes(bytes[12..16].try_into().unwrap()) as usize;
+    serde_json::from_slice(&bytes[20..20 + length]).unwrap()
+}
+
+#[test]
+fn face_identity_survives_index_chunks_and_all_compression_modes() {
+    for options in [Options::default(), Options::lean(), Options::compact()] {
+        let bytes = write_bytes(&fixture(), &options).unwrap();
+        // This Rust reader does not implement KHR_mesh_quantization; validate
+        // plain output with it, inspect identity metadata for all modes.
+        if options.compression == Compression::None {
+            gltf::Gltf::from_slice(&bytes).unwrap();
+        }
+        let json = json_of(&bytes);
+        let primitives = json["meshes"][0]["primitives"].as_array().unwrap();
+        assert_eq!(primitives.len(), 2);
+        assert_eq!(
+            primitives[0]["extras"]["bimSourceMap"]["faceRanges"],
+            json!([[0, 21845, "42"]])
+        );
+        assert_eq!(
+            primitives[1]["extras"]["bimSourceMap"]["faceRanges"],
+            json!([[0, 1, "42"], [1, 1, "99"]])
+        );
+        assert_eq!(primitives[1]["extras"]["bimSourceMap"]["body"], "7");
+        assert_eq!(write_bytes(&fixture(), &options).unwrap(), bytes);
+    }
+}
+
+#[test]
+fn changed_index_order_and_partial_material_ranges_fail_export() {
+    let mut scene = fixture();
+    scene.geometry[0].mesh.as_mut().unwrap().indices.swap(0, 1);
+    assert!(matches!(
+        write_bytes(&scene, &Options::default()),
+        Err(ExportError::BadMesh(_))
+    ));
+    let mut scene = fixture();
+    scene.geometry[0]
+        .mesh
+        .as_mut()
+        .unwrap()
+        .parts
+        .push(cad_ir::mesh::MeshPart {
+            material: 0,
+            start: 3,
+            count: 3,
+        });
+    assert!(matches!(
+        write_bytes(&scene, &Options::default()),
+        Err(ExportError::BadMesh(_))
+    ));
+    assert!(scene.source_faces.contains_key(&GeometryId(0)));
+}
