+    fn pcurve_rank(&self, pcurve: usize) -> u8 {
+        let Some(mut entity) = self.index.get(&pcurve) else {
+            return 1;
+        };
+        if entity.type_id == xt::TRIMMED_CURVE {
+            let Some(basis) = self.index.get(&ptr(self.entities, entity, 7)) else {
+                return 1;
+            };
+            entity = basis;
+        }
+        if entity.type_id != xt::SP_CURVE {
+            return 1;
+        }
+        let surface_type = self
+            .index
+            .get(&ptr(self.entities, entity, 7))
+            .map(|surface| surface.type_id);
+        pcurve_support_rank(surface_type)
+    }
