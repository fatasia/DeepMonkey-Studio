+/// Refine a chart onto one known surface while retaining the chart's branch.
+///
+/// This is the inexpensive form for a blend boundary: the exact blend surface
+/// is costly to reconstruct, but the same edge is also defined on its analytic
+/// mating surface. The chart selects the curve; projection removes its chordal
+/// departure from that known surface.
+pub fn projected_surface_polyline(
+    surface: &Surface,
+    guide: &[Vec3],
+    tolerance: f64,
+    guide_slack: f64,
+) -> Option<Curve> {
+    let project = |seed: Vec3| {
+        let point = surface.point_at(surface.invert(seed, None)?);
+        ((point - seed).length() <= guide_slack).then_some(point)
+    };
+    fn refine(
+        surface: &Surface,
+        seed0: Vec3,
+        point0: Vec3,
+        seed1: Vec3,
+        point1: Vec3,
+        tolerance: f64,
+        slack: f64,
+        depth: u8,
+        out: &mut Vec<Vec3>,
+    ) -> Option<()> {
+        let seed_mid = seed0.lerp(seed1, 0.5);
+        let point_mid = surface.point_at(surface.invert(seed_mid, None)?);
+        if (point_mid - seed_mid).length() > slack {
+            return None;
+        }
+        let sag = (point_mid - point0.lerp(point1, 0.5)).length();
+        if sag > tolerance * 0.5 && depth < 12 {
+            refine(surface, seed0, point0, seed_mid, point_mid, tolerance, slack, depth + 1, out)?;
+            refine(surface, seed_mid, point_mid, seed1, point1, tolerance, slack, depth + 1, out)?;
+        } else {
+            out.push(point1);
+        }
+        Some(())
+    }
+
+    let first = *guide.first()?;
+    let mut point0 = project(first)?;
+    let mut points = vec![point0];
+    for seeds in guide.windows(2) {
+        let point1 = project(seeds[1])?;
+        refine(surface, seeds[0], point0, seeds[1], point1, tolerance, guide_slack, 0, &mut points)?;
+        point0 = point1;
+    }
+    (points.len() > 2).then(|| Curve::Polyline { points })
+}
