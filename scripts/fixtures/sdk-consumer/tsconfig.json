{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": [], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "skipLibCheck": false, "rootDir": ".", "outDir": "out/node"
  },
  "include": ["*.ts"], "exclude": ["out", "node_modules"]
}
