+/// Refine a chart onto the two surfaces whose intersection it represents.
+/// Every inserted point starts on a chart chord and may move only within the
+/// chart's local resolution, so refinement cannot jump to another branch.
+pub fn projected_intersection_polyline(
+    a: &Surface,
+    b: &Surface,
+    guide: &[Vec3],
+    tolerance: f64,
+    guide_slack: f64,
+) -> Option<Curve> {
+    fn settle(a: &Surface, b: &Surface, seed: Vec3, tolerance: f64, slack: f64) -> Option<Vec3> {
+        let mut p = seed;
+        for _ in 0..12 {
+            let before = p;
+            p = a.point_at(a.invert(p, None)?);
+            p = b.point_at(b.invert(p, None)?);
+            if (p - before).length() <= tolerance * 1e-3 { break; }
+        }
+        let va = a.invert(p, None)?;
+        let vb = b.invert(p, None)?;
+        let off = (a.point_at(va) - p).length().max((b.point_at(vb) - p).length());
+        (off <= tolerance && (p - seed).length() <= slack).then_some(p)
+    }
+    fn refine(
+        a: &Surface, b: &Surface,
+        seed0: Vec3, point0: Vec3, seed1: Vec3, point1: Vec3,
+        tolerance: f64, slack: f64, depth: u8, out: &mut Vec<Vec3>,
+    ) -> Option<()> {
+        let seed_mid = seed0.lerp(seed1, 0.5);
+        let point_mid = settle(a, b, seed_mid, tolerance, slack)?;
+        let sag = (point_mid - point0.lerp(point1, 0.5)).length();
+        if sag > tolerance * 0.5 && depth < 12 {
+            refine(a, b, seed0, point0, seed_mid, point_mid, tolerance, slack, depth + 1, out)?;
+            refine(a, b, seed_mid, point_mid, seed1, point1, tolerance, slack, depth + 1, out)?;
+        } else {
+            out.push(point1);
+        }
+        Some(())
+    }
+
+    let first = *guide.first()?;
+    let mut point0 = settle(a, b, first, tolerance, guide_slack)?;
+    let mut points = vec![point0];
+    for seeds in guide.windows(2) {
+        let point1 = settle(a, b, seeds[1], tolerance, guide_slack)?;
+        refine(a, b, seeds[0], point0, seeds[1], point1, tolerance, guide_slack, 0, &mut points)?;
+        point0 = point1;
+    }
+    (points.len() > 2).then(|| Curve::Polyline { points })
+}
