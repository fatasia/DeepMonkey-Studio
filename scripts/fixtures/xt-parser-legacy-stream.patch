diff --git a/native/crates/xt-parser/tests/legacy_stream.rs b/native/crates/xt-parser/tests/legacy_stream.rs
new file mode 100644
--- /dev/null
+++ b/native/crates/xt-parser/tests/legacy_stream.rs
@@ -0,0 +1,44 @@
+use xt_parser::{decode, entity::parse_entities_opt, schema};
+
+#[test]
+fn legacy_body_does_not_consume_next_entity() {
+    let mut input = "12 3 56 6 7 0 0 0 0 1e3 1e-8 2 8 0 1 0 1 9 10 11 0 12 13 0 1 0";
+    let (entities, truncated) = parse_entities_opt(&mut input, 0, false, 9).unwrap();
+    assert!(truncated.is_none(), "{truncated:?}");
+    assert!(input.trim().is_empty());
+    assert_eq!(entities.len(), 1);
+    assert_eq!(entities.fields(&entities[0]).len(), 22);
+    assert_eq!(schema::standard_schema(schema::BODY, 13).unwrap().fields.len(), 23);
+}
+
+#[test]
+fn locale_attribute_count_is_bytes_not_unicode_characters() {
+    // Includes valid UTF-8 and invalid multibyte prefixes. Both are opaque bytes.
+    let mut bytes = b"84 6 2 ".to_vec();
+    bytes.extend_from_slice(&[0xe4, 0xb8, 0xad, 0xe1, 0x80, 0xff]);
+    bytes.extend_from_slice(b"1 0");
+    let text = decode(bytes);
+    let mut input = text.as_str();
+    let (entities, truncated) = parse_entities_opt(&mut input, 0, false, 9).unwrap();
+    assert!(truncated.is_none(), "{truncated:?}");
+    assert!(input.trim().is_empty());
+    assert_eq!(entities.var_char(&entities[0]).len(), 6);
+}
+
+#[test]
+fn incomplete_or_trailing_stream_is_diagnostic() {
+    for text in ["", "3 1 0 5", "invalid", "1 0 3 1 0 5"] {
+        let mut input = text;
+        let (_, truncated) = parse_entities_opt(&mut input, 0, false, 9).unwrap();
+        assert!(truncated.is_some(), "accepted incomplete stream {text:?}");
+    }
+}
+
+#[test]
+fn truncated_entity_and_terminator_fail_closed() {
+    let mut input = "12 3 56";
+    let (_, truncated) = parse_entities_opt(&mut input, 0, false, 9).unwrap();
+    assert!(truncated.is_some());
+    let mut input = "1";
+    assert!(parse_entities_opt(&mut input, 0, false, 9).is_err());
+}

diff --git a/native/crates/xt-parser/examples/legacy_corpus.rs b/native/crates/xt-parser/examples/legacy_corpus.rs
new file mode 100644
--- /dev/null
+++ b/native/crates/xt-parser/examples/legacy_corpus.rs
@@ -0,0 +1,36 @@
+use std::path::Path;
+use xt_parser::{decode, entity, header, schema};
+
+fn audit(path: &Path, counts: &mut [usize; 3]) {
+    if path.is_dir() {
+        for entry in std::fs::read_dir(path).unwrap() {
+            audit(&entry.unwrap().path(), counts);
+        }
+        return;
+    }
+    if !path.extension().is_some_and(|x| x.eq_ignore_ascii_case("x_t")) {
+        return;
+    }
+    counts[0] += 1;
+    let text = decode(std::fs::read(path).unwrap());
+    let (_, body) = header::split_header(&text).unwrap();
+    let line = schema::parse_tline(body).unwrap();
+    let mut input = line.body.as_str();
+    let partitions = if line.has_base_schema {
+        schema::parse_schema_preamble(&mut input).unwrap().partition_count
+    } else { 0 };
+    let (entities, truncated) = entity::parse_entities_opt(
+        &mut input, partitions, line.has_base_schema, line.key_major,
+    ).unwrap();
+    let complete = truncated.is_none() && input.trim().is_empty();
+    counts[if complete { 1 } else { 2 }] += 1;
+    println!("{}\t{}\t{}\t{}\t{:?}", path.display(), complete,
+        entities.len(), input.trim().len(), truncated);
+}
+
+fn main() {
+    let root = std::env::args().nth(1).expect("legacy_corpus <directory>");
+    let mut counts = [0; 3];
+    audit(Path::new(&root), &mut counts);
+    println!("total={} complete-stream={} incomplete={}", counts[0], counts[1], counts[2]);
+}
