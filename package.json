{
  "name": "bim-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"pnpm --filter @bim-studio/api dev\" \"pnpm --filter @bim-studio/web dev\"",
    "dev:all": "concurrently -n api,web,node-red -c cyan,green,yellow \"pnpm --filter @bim-studio/api dev\" \"pnpm --filter @bim-studio/web dev\" \"pnpm --filter @bim-studio/node-red dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dwg:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/install-libredwg.ps1",
    "revit:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/revit-worker/install.ps1 -Version all",
    "start": "pnpm --filter @bim-studio/api start"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
