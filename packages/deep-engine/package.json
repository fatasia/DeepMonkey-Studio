  "scripts": {
    "build": "node ../../scripts/clean-dir.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.lab.json && tsc -p tsconfig.examples.json",
    "lab:build": "node scripts/buildLab.mjs",
    "lab:serve": "node scripts/serveLab.mjs",
    "lab:verify": "node scripts/verifyLabArtifact.mjs",
    "lab:isolation": "node scripts/verifyIsolation.mjs && node scripts/verifyLabArtifact.mjs && pnpm --filter @bim-studio/web test src/architecture.test.ts",
    "test": "vitest run src lab && node --test scripts/threeUsageScanner.test.mjs scripts/shaderUsageScanner.test.mjs scripts/runtimePurityPolicy.test.mjs scripts/collectNativeUiInventory.test.mjs && node scripts/runtimePurityGate.mjs && node scripts/sourceSizeGate.mjs && node ../../scripts/j5-dual-end-gate.mjs",
    "gate:j5": "node ../../scripts/j5-dual-end-gate.mjs",
    "gate:j5:gpu": "node ../../scripts/j5-dual-end-gate.mjs --with-gpu",
    "gate:source-size": "node scripts/sourceSizeGate.mjs",
    "gate:runtime-purity": "node scripts/runtimePurityGate.mjs",
    "wgsl:sync": "node scripts/syncSharedWgsl.mjs",
    "benchmark:residency-planner": "node scripts/benchmarkPacketResidencyPlanner.mjs",
    "benchmark:three-incremental": "tsx scripts/benchmarkThreeProjectionIncremental.ts",
    "inventory:three": "node scripts/collectThreeInventory.mjs",
    "inventory:shader": "node scripts/collectShaderInventory.mjs test-output/diagnostics/shader-source-inventory.json",
    "inventory:native-ui": "node scripts/collectNativeUiInventory.mjs",
    "test:r2-shader-ir-gpu": "node scripts/r2ShaderIrGpuTest.mjs",
    "test:r4-hiz-wiring-gpu": "node scripts/r4HiZWiringGpuTest.mjs",
    "test:g7-volumetric-fog-gpu": "node scripts/volumetricFogGpuTest.mjs",
    "test:ray-trace-gpu": "node scripts/rayTraceGpuTest.mjs",
    "test:cluster-lod-gpu": "node scripts/clusterLodGpuTest.mjs",
    "test:auto-exposure-gpu": "node scripts/autoExposureGpuTest.mjs",
    "test:white-furnace-gpu": "node scripts/whiteFurnaceGpuTest.mjs",
    "test:clearcoat-furnace-gpu": "node scripts/clearcoatFurnaceGpuTest.mjs",
    "test:advanced-material-gpu": "node scripts/advancedMaterialGpuTest.mjs",
    "test:advanced-material-three-parity": "node scripts/advancedMaterialThreeParityTest.mjs",
    "test:contact-shadow-gpu": "node scripts/contactShadowGpuTest.mjs",
    "test:soft-raster-gpu": "node scripts/softRasterizeGpuTest.mjs",
    "test:probe-occlusion-gpu": "node scripts/probeOcclusionGpuTest.mjs",
    "test:probe-radiance-gpu": "node scripts/probeRadianceGpuTest.mjs",
    "test:probe-grid-bake-gpu": "node scripts/probeGridBakeGpuTest.mjs",
    "test:shadow-ray-gpu": "node scripts/shadowRayGpuTest.mjs"
