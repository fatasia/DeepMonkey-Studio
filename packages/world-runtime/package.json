{
  "name": "@bim-studio/world-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "World API v1 无头确定性运行时（Rapier 固定步长，Node 可运行，不依赖浏览器/DOM/WebGPU）",
  "type": "module",
  "files": ["dist", "src", "README.md"],
  "exports": {
    ".": {
      "development": { "types": "./src/index.ts", "default": "./src/index.ts" },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dir.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bim-studio/contracts": "workspace:*",
    "@bim-studio/scene-sdk": "workspace:*",
    "@dimforge/rapier3d-compat": "0.19.3"
  },
  "devDependencies": { "@types/node": "^24.10.0", "typescript": "^5.9.3", "vitest": "^4.1.0" }
}
