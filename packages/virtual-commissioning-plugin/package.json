{
  "name": "@bim-studio/virtual-commissioning-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": { "types": "./src/index.ts", "default": "./src/index.ts" },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dir.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bim-studio/contracts": "workspace:*",
    "@bim-studio/plugin-runtime": "workspace:*"
  },
  "peerDependencies": {
    "node-opcua-client": "2.178.0"
  },
  "peerDependenciesMeta": {
    "node-opcua-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
