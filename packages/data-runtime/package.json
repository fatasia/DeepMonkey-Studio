{
  "name": "@bim-studio/data-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": { "types": "./src/index.ts", "default": "./src/index.ts" },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./script": {
      "development": { "types": "./src/script.ts", "default": "./src/script.ts" },
      "types": "./dist/script.d.ts",
      "default": "./dist/script.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dir.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "quickjs-emscripten": "^0.32.0" },
  "devDependencies": { "@types/node": "^24.10.0", "typescript": "^5.9.3", "vitest": "^4.1.0" }
}
