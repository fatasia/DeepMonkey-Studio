{
  "name": "@bim-studio/jt-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": { "types": "./src/index.ts", "default": "./src/index.ts" },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": { "types": "./src/fixtureSynthesis.test-helper.ts", "default": "./src/fixtureSynthesis.test-helper.ts" },
      "types": "./dist/fixtureSynthesis.test-helper.d.ts",
      "default": "./dist/fixtureSynthesis.test-helper.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dir.mjs dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "xz-decompress": "0.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
