API_PORT=4100
WEB_ORIGIN=http://localhost:5173
# Optional. If omitted, data is stored in the repository-level data directory.
# Relative custom paths are resolved from the API process working directory.
# DATA_DIR=D:\BimStudioData

# Metadata storage. The JSON mode needs no external service; PostgreSQL mode
# automatically creates the database/table and imports data/database.json once.
METADATA_STORE=json
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=bim_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PSQL_PATH=C:\Program Files\PostgreSQL\18\bin\psql.exe

# Model/object storage. Local mode serves DATA_DIR directly. MinIO mode creates
# the bucket and migrates existing project files on startup.
OBJECT_STORE=local
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=bim-studio
MINIO_ALIAS=bim-local
MINIO_MC_PATH=D:\Tools\minio\mc.exe

# RVT conversion uses the self-developed persistent Revit Worker + Add-in.
# Install a licensed Revit, run `pnpm revit:install`, then point the API at the
# published worker. The first task starts Revit; later native GLB and IFC tasks
# reuse that process instead of reopening Revit for every file.
REVIT_2023_PATH=C:\Program Files\Autodesk\Revit 2023\Revit.exe
REVIT_2026_PATH=C:\Program Files\Autodesk\Revit 2026\Revit.exe
RVT_CONVERTER_COMMAND=D:\Documents\bim\bim-studio\tools\revit-worker\publish\BimStudio.RevitWorker.exe
RVT_CONVERTER_ARGS=["--input","{input}","--output","{output}","--mode","{mode}"]
RVT_REVIT_VERSION=2026
# Worker jobs/results/cache. Keep this on a data disk; relative paths resolve
# from the project root when launched by the BIM Studio scripts.
BIM_STUDIO_WORKER_ROOT=.cache/revit-worker

# DWG uses the open-source GNU LibreDWG dwg2dxf executable. Run
# `pnpm dwg:install` for the default tools/libredwg location. Override only
# when LibreDWG is installed elsewhere.
# DWG_CONVERTER_COMMAND=D:\Tools\libredwg\dwg2dxf.exe
# DWG_CONVERTER_ARGS=["-y","-o","{output}/model.dxf","{input}"]
