API_PORT=4100
# Web 开发代理和一键启动健康检查。若 API 在另一台机器或端口，填写其 Origin；
# 未填写时自动使用 http://127.0.0.1:${API_PORT}。
# BIM_STUDIO_API_ORIGIN=http://127.0.0.1:4100
AI_BASE_URL=https://api.openai.com/v1

# SPM-PINO/TwinMoE native inference. The local launcher manages this Rust
# ONNX Runtime service unless BATTERY_NATIVE_RUNTIME_MANAGED=false.
BATTERY_MODEL_SERVICE_URL=http://127.0.0.1:8030
BATTERY_NATIVE_RUNTIME_MANAGED=true
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_PROTOCOL=auto
AI_TEMPERATURE=0.2
BIM_STUDIO_ADMIN_PASSWORD=admin
BIM_STUDIO_SESSION_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:5173
# Web binds to all local interfaces by default, so it can be opened by LAN IP.
BIM_STUDIO_WEB_HOST=0.0.0.0
BIM_STUDIO_WEB_PORT=5173
# Set true, or run pnpm studio start web --https. Certificate paths are relative
# to the repository root unless absolute paths are supplied.
BIM_STUDIO_HTTPS=false
BIM_STUDIO_HTTPS_KEY=https/private.key
BIM_STUDIO_HTTPS_CERT=https/self-sign.cert
# Optional. If omitted, data is stored in the repository-level data directory.
# Relative custom paths are resolved from the API process working directory.
# DATA_DIR=D:\BimStudioData
# ASSET_LIBRARY_DIR=D:\BimStudioData\external-assets\source-a

# Metadata storage. The JSON mode needs no external service; PostgreSQL mode
# automatically creates the database/table and imports data/database.json once.
METADATA_STORE=json
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=bim_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PSQL_PATH=C:\Program Files\PostgreSQL\18\bin\psql.exe
# 恢复验证/灾备恢复才需要维护账号；正式环境从密钥管理器临时注入，不建议长期写入 .env。
# POSTGRES_MAINTENANCE_USER=postgres
# POSTGRES_MAINTENANCE_PASSWORD=

# Model/object storage. Local mode serves DATA_DIR directly. MinIO mode creates
# the bucket and migrates existing project files on startup.
OBJECT_STORE=local
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=bim-studio
MINIO_ALIAS=bim-local
MINIO_MC_PATH=D:\Tools\minio\mc.exe
# 创建临时恢复 Bucket 时需要维护账号；普通 API 只使用上方最小权限服务账号。
# MINIO_MAINTENANCE_ACCESS_KEY=
# MINIO_MAINTENANCE_SECRET_KEY=

# RVT conversion uses the self-developed persistent Revit Worker + Add-in.
# Install a licensed Revit, run `pnpm revit:install`, then point the API at the
# published worker. The first task starts Revit; later native GLB and IFC tasks
# reuse that process instead of reopening Revit for every file.
REVIT_2023_PATH=C:\Program Files\Autodesk\Revit 2023\Revit.exe
REVIT_2026_PATH=C:\Program Files\Autodesk\Revit 2026\Revit.exe
RVT_CONVERTER_COMMAND=D:\Documents\bim\bim-studio\tools\revit-worker\publish\BimStudio.RevitWorker.exe
RVT_CONVERTER_ARGS=["--input","{input}","--output","{output}","--mode","{mode}"]
RVT_REVIT_VERSION=2026
# Worker jobs/results/cache. Keep this on a data disk; relative paths resolve
# from the project root when launched by the BIM Studio scripts.
BIM_STUDIO_WORKER_ROOT=.cache/revit-worker

# Oracle 12.1+ defaults to Thin mode and does not require Instant Client. Keep
# these paths for Oracle 11g or when the Oracle node is switched to Thick mode.
ORACLE_INSTANT_CLIENT_DIR=D:\Documents\bim\oracle\instantclient_19_31
TNS_ADMIN=D:\Documents\bim\oracle\instantclient_19_31\network\admin
# Optional TDengine connection values for local connector testing.
TDENGINE_REST_URL=http://127.0.0.1:6041
TDENGINE_WS_URL=ws://127.0.0.1:6041
TDENGINE_DATABASE=test
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
# Oracle example defaults to Thin mode. ORACLE_DATABASE is the service name.
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_DATABASE=ORCL
ORACLE_USER=example-user
ORACLE_PASSWORD=change-me
# DWG uses the open-source GNU LibreDWG dwg2dxf executable. Run
# `pnpm dwg:install` for the default tools/libredwg location. Override only
# when LibreDWG is installed elsewhere.
# DWG_CONVERTER_COMMAND=D:\Tools\libredwg\dwg2dxf.exe
# DWG_CONVERTER_ARGS=["-y","-o","{output}/model.dxf","{input}"]

# Optional real cloud-render GPU Worker. All three values are required before
# the admin control plane permits a session. See docs/cloud-render-worker-contract.md.
# CLOUD_RENDER_WORKER_URL=https://gpu-worker.example.com/control
# CLOUD_RENDER_WORKER_TOKEN=replace-with-worker-control-token
# CLOUD_RENDER_PUBLIC_ORIGIN=https://studio.example.com
# CLOUD_RENDER_REQUEST_TIMEOUT_MS=5000
# CLOUD_RENDER_HEALTH_MAX_AGE_MS=15000
# CLOUD_RENDER_MEDIA_MAX_AGE_MS=15000

# Reference GPU Worker process (apps/cloud-render-worker). The control-plane
# token above and the Worker token below must be identical.
# CLOUD_RENDER_WORKER_ID=gpu-worker-1
# CLOUD_RENDER_WORKER_HOST=0.0.0.0
# CLOUD_RENDER_WORKER_PORT=4200
# CLOUD_RENDER_WORKER_PUBLIC_ORIGIN=https://gpu-worker.example.com
# CLOUD_RENDER_CHROMIUM_PATH=/usr/bin/chromium
# CLOUD_RENDER_HEADLESS=false
# CLOUD_RENDER_MAX_SESSIONS=1
# CLOUD_RENDER_GPU_MEMORY_MIB=24576
# Only set after operations verified Chromium uses the listed hardware encoder.
# CLOUD_RENDER_VERIFIED_HARDWARE_CODECS=h264
# CLOUD_RENDER_ICE_SERVERS_JSON=[{"urls":"turn:turn.example.com:3478","username":"cloud","credential":"replace-me"}]
